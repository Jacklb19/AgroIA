# syntax=docker/dockerfile:1
# Job horario de precios (run_prices.py --mode hourly): solo requirements-precios.txt (sin geopandas, optuna, shap...).
ARG PYTHON_VERSION=3.13

FROM python:${PYTHON_VERSION}-slim AS build
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
WORKDIR /w
COPY requirements-precios.txt ./
RUN pip install -r requirements-precios.txt

FROM python:${PYTHON_VERSION}-slim
# libgomp1: requerido en runtime por xgboost (OpenMP) en imagenes slim.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && apt-get clean \
    && useradd --create-home --uid 10001 app
COPY --from=build /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY --chown=app:app config ./config
COPY --chown=app:app extract ./extract
COPY --chown=app:app clean ./clean
COPY --chown=app:app load ./load
COPY --chown=app:app migrations ./migrations
COPY --chown=app:app models ./models
COPY --chown=app:app utils ./utils
COPY --chown=app:app run_prices.py ./
RUN mkdir -p data logs && chown app:app data logs
USER app
CMD ["python", "run_prices.py", "--mode", "hourly"]
