# Imágenes generadas por scripts
*.png
*.jpg
*.jpeg
*.gif
*.svg

# Excepción: imágenes estáticas del frontend (necesarias para Vercel)
!web/public/images/*.png
!web/public/images/*.jpg
!web/public/images/*.svg

# Next.js
web/.next/
web/node_modules/
web/out/

