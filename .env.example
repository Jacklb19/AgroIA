# ─────────────────────────────────────────────────────────────────────
# AgroIA Colombia · variables de entorno
# Copia este archivo como `.env` y rellena los valores reales.
# ─────────────────────────────────────────────────────────────────────

# ── Backend Python (pipeline ETL + entrenamiento) ─────────────────────
SUPABASE_DB_HOST=db.xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
# Tambien se aceptan los nombres de la web (DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD) si prefieres un solo grupo.
# Si falta host, usuario o contrasena el pipeline se detiene con un mensaje que dice cual.
# SSL hacia Postgres: disable | require | verify-full (por defecto: disable en localhost, require en remoto).
# Para verify-full apunta DB_SSL_CA al archivo .crt de la CA del proveedor.
# DB_SSL=require
# DB_SSL_CA=

# Aviso operativo (opcional): Slack / Discord / Teams reciben un POST JSON cuando una etapa falla,
# la calidad de datos entra en alerta o los precios / el pipeline llevan demasiado sin actualizarse.
ALERT_WEBHOOK_URL=

# Contrasena del rol de solo lectura agroia_web (>= 12 caracteres). Se aplica con: python -m load.migrate --web-password
# Luego apunta DB_USER=agroia_web y DB_PASSWORD=<esta contrasena> en la web (Vercel).
WEB_DB_PASSWORD=

# Pruebas con base de datos (solo Postgres LOCAL y desechable: las pruebas recrean el esquema public)
# TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/agroia_test

# Año final del pipeline (por defecto = año actual)
PIPELINE_YEAR_END=2026

# Token de aplicación de Socrata (opcional; sube el límite de peticiones a datos.gov.co)
SOCRATA_TOKEN=

# Solo emergencias: permite insumos SINTÉTICOS si DANE no responde (por defecto false)
ALLOW_SYNTHETIC_INSUMOS=false

# Boletines ENSO opcionales (lista separada por comas)
ENSO_BOLETIN_URLS=

# ── Frontend Next.js (web/) ───────────────────────────────────────────
DB_HOST=db.xxxxxxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
# Solo para desarrollo con un Postgres local sin SSL (en Vercel NO lo definas)
# DB_SSL=disable
# En produccion, con la CA del proveedor: DB_SSL=verify-full y DB_SSL_CA=<contenido PEM; los saltos de linea como \n>
# Opcional: tope de tiempo por consulta en el servidor (ms). Algunos poolers no aceptan este parametro.
# DB_STATEMENT_TIMEOUT_MS=15000

# Límites del asistente (/api/chat): protegen tu ANTHROPIC_API_KEY
CHAT_LIMIT_IP_DIA=20          # mensajes por IP y por día
CHAT_LIMIT_GLOBAL_DIA=500     # mensajes en total por día (tope de gasto)
CHAT_HASH_SALT=               # texto aleatorio; las IP se guardan solo como hash

# Asistente conversacional /api/chat (Claude · Anthropic)
ANTHROPIC_API_KEY=

# Modelo Claude a usar. Opciones disponibles según tu cuenta:
#   claude-sonnet-4-5            (default, recomendado, balance precio/calidad)
#   claude-sonnet-4-6            (si tu cuenta tiene acceso a Sonnet 4.6)
#   claude-3-5-sonnet-20241022   (estable y muy disponible)
#   claude-haiku-4-5             (más barato, rápido para tool-use simple)
ANTHROPIC_MODEL=claude-sonnet-4-5
